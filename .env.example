# SQLite local (sin Docker, sin PostgreSQL)
# Vercel: DATABASE_PATH=/tmp/chatbot.db
DATABASE_PATH=./data/chatbot.db

# Ollama nativo (winget install Ollama.Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Auth (generar: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})))
AUTH_SECRET=change-me-in-production

# Almacenamiento de documentos
STORAGE_PATH=./storage

# RAG
RAG_TOP_K=5
RAG_MIN_SCORE=0.65
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# App / Branding
NEXT_PUBLIC_APP_NAME=RegulaDesk
NEXT_PUBLIC_APP_TAGLINE=Inteligencia documental corporativa
NEXT_PUBLIC_ASSISTANT_NAME=Regula
